{
  "uid": "swisstms-region-failover",
  "title": "Multi-Region Failover Health",
  "tags": ["swisstms", "phase-14"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active Region",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        { "expr": "swisstms_active_region", "legendFormat": "{{region}}" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Aurora Global DB lag (per region)",
      "gridPos": { "x": 6, "y": 0, "w": 18, "h": 8 },
      "targets": [
        { "expr": "aurora_global_db_replication_lag_seconds", "legendFormat": "{{region}}" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Kafka MirrorMaker 2 lag",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
      "targets": [
        { "expr": "kafka_mirrormaker_lag", "legendFormat": "{{source}} -> {{target}}" }
      ]
    }
  ]
}
