{
  "uid": "swisstms-oms-roundtrip",
  "title": "Swiss TMS — OMS Roundtrip (US1)",
  "tags": ["swisstms", "phase-3", "us1"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Order submission rate (POST /api/v1/orders)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"oms-service\",uri=\"/api/v1/orders\",method=\"POST\"}[1m]))",
          "legendFormat": "submits/s"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "OMS REST p99 latency (POST /api/v1/orders)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le)(rate(http_server_requests_seconds_bucket{application=\"oms-service\",uri=\"/api/v1/orders\",method=\"POST\"}[5m])))",
          "legendFormat": "p99"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le)(rate(http_server_requests_seconds_bucket{application=\"oms-service\",uri=\"/api/v1/orders\",method=\"POST\"}[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Outbox depth (cold.oms.event.v1 backlog)",
      "gridPos": { "x": 0, "y": 6, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "swisstms_outbox_depth{application=\"oms-service\"}",
          "legendFormat": "events queued"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Audit chain — events published",
      "gridPos": { "x": 6, "y": 6, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "swisstms_audit_events_total",
          "legendFormat": "audit events"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "FIX session health — venue-adapter-six",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "swisstms_venue_session_status{application=\"venue-adapter-six\"}",
          "legendFormat": "{{venue_mic}} status"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Recent ExecutionReports (cold.exec.fill.v1)",
      "gridPos": { "x": 0, "y": 10, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{application=\"oms-service\"} |= \"ORDER_FILLED\" | json",
          "legendFormat": ""
        }
      ]
    }
  ]
}
