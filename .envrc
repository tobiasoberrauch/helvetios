# direnv-Hook (https://direnv.net/) — Auto-Aktivierung der mise-pinned-Tools
# beim cd ins Verzeichnis. Benötigt: `direnv allow` einmalig.
#
# Nicht zwingend — wer mise direkt in der Shell aktiviert hat
# (`eval "$(mise activate zsh)"`), braucht das nicht.

if has mise; then
  eval "$(mise direnv activate)"
fi

# Standard-Dev-Defaults (überschreibbar pro Shell)
export SWISSTMS_REGION="${SWISSTMS_REGION:-ZH}"
export SPRING_PROFILES_ACTIVE="${SPRING_PROFILES_ACTIVE:-dev}"

# Shortcuts für die häufigsten Endpunkte gegen tilt up
export OMS_URL="${OMS_URL:-http://localhost:8080}"
export PG_URL="${PG_URL:-postgresql://swisstms:swisstms-dev@localhost:5432/swisstms}"
export KAFKA_BOOTSTRAP="${KAFKA_BOOTSTRAP:-localhost:9092}"
