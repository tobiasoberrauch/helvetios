root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false  # Markdown trailing space = hard line break

[*.{yaml,yml,json,toml}]
indent_size = 2

[*.{ts,tsx,js,jsx}]
indent_size = 2

[*.go]
indent_style = tab

[Makefile]
indent_style = tab
