<?xml version="1.0" encoding="UTF-8"?>
<!--
  Stub FIXT 1.1 transport dictionary. FIXT.1.1 enthält nur Session-Layer-
  Messages (Logon/Heartbeat/Logout/...) — Application-Messages laufen über
  FIX 5.0 SP2 (siehe FIX50SP2.xml). Wird in `make scaffold` durch das
  vollständige Dictionary aus `org.quickfixj:quickfixj-messages-fixt11:2.3.2`
  ersetzt.
-->
<fix type="FIXT" major="1" minor="1">
  <header>
    <field name="BeginString" required="Y"/>
    <field name="BodyLength" required="Y"/>
    <field name="MsgType" required="Y"/>
    <field name="SenderCompID" required="Y"/>
    <field name="TargetCompID" required="Y"/>
    <field name="MsgSeqNum" required="Y"/>
    <field name="SendingTime" required="Y"/>
    <field name="ApplVerID" required="N"/>
  </header>
  <messages>
    <message name="Logon" msgtype="A" msgcat="admin">
      <field name="EncryptMethod" required="Y"/>
      <field name="HeartBtInt" required="Y"/>
      <field name="DefaultApplVerID" required="Y"/>
    </message>
    <message name="Logout" msgtype="5" msgcat="admin">
      <field name="Text" required="N"/>
    </message>
    <message name="Heartbeat" msgtype="0" msgcat="admin">
      <field name="TestReqID" required="N"/>
    </message>
    <message name="TestRequest" msgtype="1" msgcat="admin">
      <field name="TestReqID" required="Y"/>
    </message>
    <message name="ResendRequest" msgtype="2" msgcat="admin">
      <field name="BeginSeqNo" required="Y"/>
      <field name="EndSeqNo" required="Y"/>
    </message>
    <message name="SequenceReset" msgtype="4" msgcat="admin">
      <field name="GapFillFlag" required="N"/>
      <field name="NewSeqNo" required="Y"/>
    </message>
    <message name="Reject" msgtype="3" msgcat="admin">
      <field name="RefSeqNum" required="Y"/>
      <field name="Text" required="N"/>
    </message>
  </messages>
  <fields>
    <field number="1128" name="ApplVerID" type="STRING"/>
    <field number="1137" name="DefaultApplVerID" type="STRING"/>
  </fields>
</fix>
