<?xml version="1.0" encoding="UTF-8"?>
<!--
  SIX STI (Standard Trading Interface) FIX 4.4 dialect — Stub.

  Dieser Stub übernimmt das FIX 4.4 Standard-Dictionary 1:1 und ergänzt
  SIX-spezifische Felder, die in der Member-Section publiziert sind.
  Vollständige Spec: SIX Swiss Exchange Member Section.

  Phase 3 (US1) verwendet diesen Dialekt für den Initial-End-to-End-Roundtrip.
-->
<fix major="4" minor="4" servicepack="0">
  <header>
    <field name="BeginString" required="Y"/>
    <field name="BodyLength" required="Y"/>
    <field name="MsgType" required="Y"/>
    <field name="SenderCompID" required="Y"/>
    <field name="TargetCompID" required="Y"/>
    <field name="MsgSeqNum" required="Y"/>
    <field name="SendingTime" required="Y"/>
    <field name="PossDupFlag" required="N"/>
    <field name="OrigSendingTime" required="N"/>
  </header>
  <messages>
    <!-- Inherits NewOrderSingle, ExecutionReport, OrderCancelRequest,
         OrderCancelReplaceRequest, OrderCancelReject, BusinessMessageReject
         from FIX44.xml; SIX-specific extensions added below. -->
  </messages>
  <fields>
    <!-- SIX-specific custom tags. Must NOT conflict with platform-wide
         custom tags (7777-7780). -->
    <field number="9101" name="SixOrderQualifier" type="STRING"/>
    <field number="9102" name="SixFunariFlag" type="BOOLEAN"/>
  </fields>
</fix>
