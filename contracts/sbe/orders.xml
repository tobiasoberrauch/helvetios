<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   package="ch.swisstms.sbe.orders"
                   id="1"
                   version="1"
                   semanticVersion="1.0.0"
                   description="Swiss-TMS Hot-Path Orders"
                   byteOrder="littleEndian">
  <types>
    <composite name="messageHeader" description="Message identifiers and length of message root">
      <type name="blockLength" primitiveType="uint16"/>
      <type name="templateId"  primitiveType="uint16"/>
      <type name="schemaId"    primitiveType="uint16"/>
      <type name="version"     primitiveType="uint16"/>
    </composite>
    <type name="OrderId" primitiveType="uint64"/>
    <type name="ClientId" primitiveType="uint64"/>
    <type name="Isin" primitiveType="char" length="12" characterEncoding="ASCII"/>
    <type name="Mic"  primitiveType="char" length="4"  characterEncoding="ASCII"/>
    <type name="ClOrdId" primitiveType="char" length="32" characterEncoding="ASCII"/>
    <type name="VenueOrderId" primitiveType="char" length="32" characterEncoding="ASCII"/>
    <type name="ScaledQty" primitiveType="int64" description="quantity scaled by 1e8"/>
    <type name="ScaledPrice" primitiveType="int64" description="price scaled by 1e8; INT64_MIN = MARKET"/>
    <type name="EpochNanos" primitiveType="uint64"/>

    <enum name="Side" encodingType="uint8">
      <validValue name="BUY">1</validValue>
      <validValue name="SELL">2</validValue>
      <validValue name="SELL_SHORT">3</validValue>
    </enum>
    <enum name="OrdType" encodingType="uint8">
      <validValue name="MARKET">1</validValue>
      <validValue name="LIMIT">2</validValue>
      <validValue name="STOP">3</validValue>
      <validValue name="STOP_LIMIT">4</validValue>
      <validValue name="FUNARI">5</validValue>
      <validValue name="MOO">6</validValue>
      <validValue name="LOO">7</validValue>
    </enum>
    <enum name="TimeInForce" encodingType="uint8">
      <validValue name="DAY">1</validValue>
      <validValue name="IOC">2</validValue>
      <validValue name="FOK">3</validValue>
      <validValue name="GTC">4</validValue>
      <validValue name="GTD">5</validValue>
      <validValue name="OPG">6</validValue>
    </enum>
    <enum name="Region" encodingType="uint8">
      <validValue name="ZH">1</validValue>
      <validValue name="LD4">2</validValue>
      <validValue name="NY4">3</validValue>
      <validValue name="TY3">4</validValue>
    </enum>
    <enum name="RejectReason" encodingType="uint8">
      <validValue name="FAT_FINGER_NOTIONAL">1</validValue>
      <validValue name="FAT_FINGER_QUANTITY">2</validValue>
      <validValue name="MAX_ORDER_SIZE">3</validValue>
      <validValue name="DAILY_NOTIONAL_LIMIT">4</validValue>
      <validValue name="THROTTLE_PER_SECOND">5</validValue>
      <validValue name="THROTTLE_IN_FLIGHT">6</validValue>
      <validValue name="INSTRUMENT_RESTRICTED">7</validValue>
      <validValue name="KILL_SWITCH_TRIPPED">8</validValue>
      <validValue name="UNKNOWN_CLIENT">9</validValue>
      <validValue name="UNKNOWN_INSTRUMENT">10</validValue>
    </enum>
  </types>

  <sbe:message name="OrderSubmit" id="1" description="Submit a new order">
    <field name="orderIdHigh"       id="1"  type="OrderId"/>
    <field name="orderIdLow"        id="2"  type="OrderId"/>
    <field name="clOrdId"           id="3"  type="ClOrdId"/>
    <field name="clientId"          id="4"  type="ClientId"/>
    <field name="instrumentIsin"    id="5"  type="Isin"/>
    <field name="instrumentMic"     id="6"  type="Mic"/>
    <field name="side"              id="7"  type="Side"/>
    <field name="ordType"           id="8"  type="OrdType"/>
    <field name="quantity"          id="9"  type="ScaledQty"/>
    <field name="price"             id="10" type="ScaledPrice"/>
    <field name="timeInForce"       id="11" type="TimeInForce"/>
    <field name="bizTimeNanos"      id="12" type="EpochNanos"/>
    <field name="region"            id="13" type="Region"/>
  </sbe:message>

  <sbe:message name="OrderAck" id="2" description="Venue acknowledgement">
    <field name="orderIdHigh"       id="1" type="OrderId"/>
    <field name="orderIdLow"        id="2" type="OrderId"/>
    <field name="venueOrderId"      id="3" type="VenueOrderId"/>
    <field name="venueAckTimeNanos" id="4" type="EpochNanos"/>
  </sbe:message>

  <sbe:message name="OrderCancel" id="3" description="Cancel an outstanding order">
    <field name="orderIdHigh"       id="1" type="OrderId"/>
    <field name="orderIdLow"        id="2" type="OrderId"/>
    <field name="origClOrdId"       id="3" type="ClOrdId"/>
    <field name="bizTimeNanos"      id="4" type="EpochNanos"/>
  </sbe:message>

  <sbe:message name="OrderReplace" id="4" description="Replace (modify) an outstanding order">
    <field name="orderIdHigh"       id="1" type="OrderId"/>
    <field name="orderIdLow"        id="2" type="OrderId"/>
    <field name="origClOrdId"       id="3" type="ClOrdId"/>
    <field name="newQuantity"       id="4" type="ScaledQty"/>
    <field name="newPrice"          id="5" type="ScaledPrice"/>
    <field name="bizTimeNanos"      id="6" type="EpochNanos"/>
  </sbe:message>

  <sbe:message name="RiskRejection" id="5" description="Pre-trade risk gateway rejection">
    <field name="orderIdHigh"       id="1" type="OrderId"/>
    <field name="orderIdLow"        id="2" type="OrderId"/>
    <field name="reason"            id="3" type="RejectReason"/>
    <field name="evaluationNanos"   id="4" type="uint32"/>
  </sbe:message>

</sbe:messageSchema>
