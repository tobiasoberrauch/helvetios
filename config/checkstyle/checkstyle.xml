<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Swiss Trading & Market Support Platform — Checkstyle config.

  This is a starting set covering critical formatting and naming. The
  Constitution-driven rules (no System.currentTimeMillis() outside of
  libs/time-sync/, hexagonal-import-prohibitions, FIX-tag-collision check)
  are implemented as ArchUnit tests (Phase 5) and as custom Spotless rules
  (Phase 2) rather than Checkstyle modules.
-->

<module name="Checker">
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- Forbid trailing whitespace anywhere in the source tree. -->
    <module name="RegexpSingleline">
        <property name="format" value="\s+$"/>
        <property name="message" value="Trailing whitespace forbidden."/>
    </module>

    <module name="LineLength">
        <property name="max" value="120"/>
    </module>

    <module name="TreeWalker">
        <module name="MissingDeprecated"/>
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="AvoidStarImport"/>
        <module name="OuterTypeFilename"/>
        <module name="PackageDeclaration"/>
        <module name="ConstantName">
            <!-- Allow SLF4J convention `log` and `logger` as constant names. -->
            <property name="format" value="^(log|logger|[A-Z][A-Z0-9]*(_[A-Z0-9]+)*)$"/>
        </module>
        <module name="LocalVariableName"/>
        <module name="MemberName"/>
        <module name="MethodName">
            <!-- Underscores are conventional in test method names (BDD style). -->
            <property name="format" value="^[a-z][a-zA-Z0-9_]*$"/>
        </module>
        <module name="PackageName">
            <!-- Allow snake_case in package names (e.g. ch.swisstms.audit_chain). -->
            <property name="format" value="^[a-z]+(\.[a-zA-Z_][a-zA-Z0-9_]*)*$"/>
        </module>
        <module name="ParameterName"/>
        <module name="TypeName"/>
        <module name="EqualsHashCode"/>
        <module name="MissingSwitchDefault"/>
    </module>
</module>
